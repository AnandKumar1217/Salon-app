# =================================================================
# GLAMORA MOBILE APP (ANDROID: com.glamora.app)
# =================================================================

# 1. Backend REST API URL (Points to Next.js API on port 3001)
# For Android emulator: http://10.0.2.2:3001
# For physical Android on LAN: http://10.142.53.27:3001
# For local web / metro: http://localhost:3001
EXPO_PUBLIC_BACKEND_API_URL=http://localhost:3001

# 2. Cloudinary Media Storage (Replaces Firebase Storage)
# Obtain from https://cloudinary.com/console
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# 3. Support & Contact
EXPO_PUBLIC_DEFAULT_SUPPORT_WHATSAPP=+919845198012

# 4. Strict Zero Mock Policy (false = real MongoDB & Cloudinary only)
EXPO_PUBLIC_USE_LOCAL_MOCK_FALLBACK=false


