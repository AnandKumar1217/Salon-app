{
  "expo": {
    "name": "Glamora",
    "slug": "glamora",
    "scheme": "glamora",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.glamora.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow Glamora to use your camera to take salon and profile photos.",
        "NSPhotoLibraryUsageDescription": "Allow Glamora to access your photos to set salon logos, cover pictures, and profile photos.",
        "NSLocationWhenInUseUsageDescription": "Glamora uses your location to discover premier salons and spas nearby."
      }
    },
    "android": {
      "package": "com.glamora.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#4A1E36",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.CALL_PHONE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.CAMERA"
      ],
      "predictiveBackGestureEnabled": true,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "glamora.example",
              "pathPrefix": "/salon"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "glamora"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Glamora to access your photos to set salon logos, cover pictures, and profile photos.",
          "cameraPermission": "Allow Glamora to use your camera to take salon and profile photos."
        }
      ],
      "expo-secure-store",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/splash-icon.png",
          "color": "#4A1E36"
        }
      ],
      "expo-splash-screen"
    ]
  }
}
