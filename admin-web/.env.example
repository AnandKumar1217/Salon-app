# =================================================================
# GLAMORA PLATFORM — ADMIN & BACKEND API ENVIRONMENT VARIABLES
# =================================================================

# 1. MongoDB Database Configuration (Replaces Firebase Firestore)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/glamora?retryWrites=true&w=majority
# Or local: mongodb://localhost:27017/glamora
MONGODB_URI=mongodb+srv://your_mongo_username:your_mongo_password@cluster0.glamora.mongodb.net/glamora?retryWrites=true&w=majority
MONGODB_DB_NAME=glamora

# 2. Cloudinary Media Storage (Replaces Firebase Storage)
# Obtain from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# 3. Security & Session
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long
SESSION_COOKIE_SECRET=at_least_32_character_random_string_for_cookie_signing

# 4. Strict Zero Mock Policy (false = real MongoDB & Cloudinary only)
NEXT_PUBLIC_USE_MOCK_FALLBACK=false


